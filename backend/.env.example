# SIGNBRIDGE AI — Backend Environment Configuration Example
# Copy this file to .env and adjust values for your environment.

# Application
PROJECT_NAME="SIGNBRIDGE AI Backend"
VERSION="1.0.0"
ENVIRONMENT="development"
API_V1_PREFIX="/api"

# Database Configuration (PostgreSQL 15+)
# Example: postgresql+psycopg://username:password@localhost:5432/signbridge_db
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/signbridge_db
DATABASE_CONNECT_TIMEOUT=2
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# JWT Authentication Secrets
# Generate a secure key in PowerShell:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173","http://localhost:3000"]

# AI Model Path (M1 Champion JSON relative to workspace root)
M1_MODEL_PATH=frontend/public/models/sign_classifier.json

# Security & Rate Limiting
RATE_LIMIT_AUTH_PER_MINUTE=20
